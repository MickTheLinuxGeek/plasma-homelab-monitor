{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mickgeeklabs.local/homelab-monitor/dashboard-v2.schema.json",
  "title": "Home-lab Monitor Dashboard API v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "api_version",
    "collector_version",
    "generated_at",
    "last_successful_observation_at",
    "overall_status",
    "summary",
    "hosts",
    "docker",
    "jellyfin",
    "errors"
  ],
  "properties": {
    "schema_version": {"const": "2"},
    "api_version": {"const": "2"},
    "collector_version": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "last_successful_observation_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "overall_status": {"$ref": "#/$defs/status"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["healthy", "degraded", "unavailable", "unknown"],
      "properties": {
        "healthy": {"type": "integer", "minimum": 0},
        "degraded": {"type": "integer", "minimum": 0},
        "unavailable": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0}
      }
    },
    "hosts": {
      "type": "array",
      "items": {"$ref": "#/$defs/host"}
    },
    "docker": {"$ref": "#/$defs/docker"},
    "jellyfin": {"$ref": "#/$defs/jellyfin"},
    "errors": {
      "type": "array",
      "items": {"$ref": "#/$defs/sourceError"}
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["healthy", "degraded", "unavailable", "unknown"]
    },
    "freshness": {
      "type": "string",
      "enum": ["fresh", "stale", "unknown"]
    },
    "errorCategory": {
      "type": "string",
      "enum": [
        "timeout",
        "tls",
        "authentication",
        "dns",
        "connection",
        "malformed_response",
        "unexpected"
      ]
    },
    "providerError": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["category", "message"],
      "properties": {
        "category": {"$ref": "#/$defs/errorCategory"},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "providerState": {
      "type": "object",
      "required": [
        "observed_at",
        "last_success_at",
        "consecutive_failure_count",
        "probe_duration_ms",
        "freshness",
        "error"
      ],
      "properties": {
        "observed_at": {"type": ["string", "null"], "format": "date-time"},
        "last_success_at": {"type": ["string", "null"], "format": "date-time"},
        "consecutive_failure_count": {"type": "integer", "minimum": 0},
        "probe_duration_ms": {"type": ["integer", "null"], "minimum": 0},
        "freshness": {"$ref": "#/$defs/freshness"},
        "error": {"$ref": "#/$defs/providerError"}
      }
    },
    "host": {
      "allOf": [
        {"$ref": "#/$defs/providerState"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "status",
            "detail",
            "dashboard_url",
            "latency_ms"
          ],
          "properties": {
            "id": {"type": "string"},
            "name": {"type": "string"},
            "status": {"$ref": "#/$defs/status"},
            "detail": {"type": "string"},
            "dashboard_url": {"type": ["string", "null"]},
            "latency_ms": {"type": ["integer", "null"], "minimum": 0},
            "observed_at": {},
            "last_success_at": {},
            "consecutive_failure_count": {},
            "probe_duration_ms": {},
            "freshness": {},
            "error": {}
          }
        }
      ]
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "image", "state", "status", "detail"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "image": {"type": "string"},
        "state": {"type": "string"},
        "status": {"$ref": "#/$defs/status"},
        "detail": {"type": "string"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status", "running", "stopped", "total", "containers"],
      "properties": {
        "id": {"type": "integer"},
        "name": {"type": "string"},
        "status": {"$ref": "#/$defs/status"},
        "running": {"type": "integer", "minimum": 0},
        "stopped": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "containers": {
          "type": "array",
          "items": {"$ref": "#/$defs/container"}
        }
      }
    },
    "docker": {
      "allOf": [
        {"$ref": "#/$defs/providerState"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "environments"],
          "properties": {
            "status": {"$ref": "#/$defs/status"},
            "environments": {
              "type": "array",
              "items": {"$ref": "#/$defs/environment"}
            },
            "observed_at": {},
            "last_success_at": {},
            "consecutive_failure_count": {},
            "probe_duration_ms": {},
            "freshness": {},
            "error": {}
          }
        }
      ]
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_name", "client", "device_name", "item_name"],
      "properties": {
        "user_name": {"type": "string"},
        "client": {"type": "string"},
        "device_name": {"type": "string"},
        "item_name": {"type": "string"}
      }
    },
    "jellyfin": {
      "allOf": [
        {"$ref": "#/$defs/providerState"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "server_name",
            "version",
            "active_sessions",
            "dashboard_url"
          ],
          "properties": {
            "status": {"$ref": "#/$defs/status"},
            "server_name": {"type": "string"},
            "version": {"type": "string"},
            "active_sessions": {
              "type": "array",
              "items": {"$ref": "#/$defs/session"}
            },
            "dashboard_url": {"type": ["string", "null"]},
            "observed_at": {},
            "last_success_at": {},
            "consecutive_failure_count": {},
            "probe_duration_ms": {},
            "freshness": {},
            "error": {}
          }
        }
      ]
    },
    "sourceError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "category", "message", "observed_at"],
      "properties": {
        "source": {"type": "string"},
        "category": {"$ref": "#/$defs/errorCategory"},
        "message": {"type": "string"},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
