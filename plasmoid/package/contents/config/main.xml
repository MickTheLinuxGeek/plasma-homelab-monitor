<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0">
    <kcfgfile name=""/>
    <group name="General">
        <entry name="collectorUrl" type="String">
            <default>http://127.0.0.1:8765</default>
        </entry>
        <entry name="refreshInterval" type="Int">
            <default>30</default>
        </entry>
        <entry name="showHosts" type="Bool">
            <default>true</default>
        </entry>
        <entry name="showDocker" type="Bool">
            <default>true</default>
        </entry>
        <entry name="showJellyfin" type="Bool">
            <default>true</default>
        </entry>
        <entry name="hostsExpanded" type="Bool">
            <default>true</default>
        </entry>
        <entry name="dockerExpanded" type="Bool">
            <default>true</default>
        </entry>
        <entry name="jellyfinExpanded" type="Bool">
            <default>true</default>
        </entry>
        <entry name="sortMode" type="String">
            <default>status</default>
        </entry>
        <entry name="issuesOnlyByDefault" type="Bool">
            <default>false</default>
        </entry>
    </group>
</kcfg>
